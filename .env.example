# HEALTH VIDEOS — PRODUCTION ENGINE ENVIRONMENT CONFIGURATION
# Copy this file to .env and insert your API keys and configuration

# 1. AI Research & Script Generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Stock Visual B-Roll (Free Pexels API)
PEXELS_API_KEY=your_pexels_api_key_here

# 3. Mandatory Female Voice Configuration (1.15x Speed)
FEMALE_VOICE_ONLY=true
VOICE_SPEED=1.15
NARRATION_LANGUAGE=hinglish
VOICE_STYLE=cinematic_documentary

# 4. Voice Engine (Default: Free edge-tts, 0 cost)
TTS_ENGINE=edge-tts
EDGE_TTS_VOICE_HINDI=hi-IN-SwaraNeural
EDGE_TTS_VOICE_HINGLISH=en-IN-NeerjaExpressiveNeural

# Optional ElevenLabs Provider (leave empty for 100% free operation)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# 5. Video Rendering Specifications (1080x1920 9:16 Shorts)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
MIN_DURATION_SECONDS=30.0
MAX_DURATION_SECONDS=50.0

# 6. Audio Production & Sound Design
ENABLE_BGM=true
BGM_DUCKING_DB=-20.0

# 7. YouTube Publishing Controls (SAFETY FIRST: Default Private & Manual Approval)
AUTO_UPLOAD=false
MANUAL_APPROVAL_REQUIRED=true
DAILY_UPLOAD_LIMIT=2
VIDEO_VISIBILITY=private
YOUTUBE_CATEGORY_ID=27
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.pickle

# 8. Automated Scheduling Daemon
TIMEZONE=Asia/Kolkata
SCHEDULE_MORNING_TIME=12:00
SCHEDULE_EVENING_TIME=18:00
